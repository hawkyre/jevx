{
  "name": "jevx",
  "description": "Find the posts worth your reply.",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "preview": "vite --host 127.0.0.1",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors",
    "release": "npm run typecheck && npm test && npm run zip && npm run zip:firefox && npm run lint:firefox && node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "web-ext": "10.6.0",
    "wxt": "0.21.4"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
